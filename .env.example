OSS_BUCKET=your_bucket_name
OSS_ENDPOINT=oss-cn-shenzhen.aliyuncs.com
OSS_REGION=cn-shenzhen
OSS_ACCESS_KEY_ID=your_access_key_id
OSS_ACCESS_KEY_SECRET=your_access_key_secret
# OSS_SECURITY_TOKEN=your_security_token_if_using_sts

# Optional. Default is https://openapi-erp.91miaoshou.com
MIAOSHOU_BASE_URL=https://openapi-erp.91miaoshou.com

# Optional. Used by the in-development single-product AI workflow only.
DEEPSEEK_API_KEY=your_deepseek_api_key
OPENAI_API_KEY=your_openai_api_key
DASHSCOPE_API_KEY=your_dashscope_api_key
ARK_API_KEY=your_volcengine_api_key
AI_API_KEY=your_custom_openai_compatible_api_key

# Optional but strongly recommended when exposing the web app outside localhost.
# Leave both empty/commented for local-only testing.
# WEB_ACCESS_PASSWORD=replace_with_a_long_random_password
# WEB_SESSION_SECRET=replace_with_a_different_long_random_secret
